<style>
.L-collage-2 .t{font-size:10.4cqw;max-height:22cqh;flex:0 1 auto;min-height:0}
.L-collage-2 .stage .a{left:0;top:2%;width:62%;height:68%;transform:rotate(-3deg);z-index:1}
.L-collage-2 .stage .b{right:0;bottom:0;width:58%;height:66%;transform:rotate(3deg);z-index:2;border:1.2cqw solid var(--bg)}
</style>
<div class="pad col gap3">
  <div class="col gap1">
    {% if c.kicker %}<div class="k">{{ c.kicker }}</div>{% endif %}
    <div class="t fit">{{ rich(c.title) }}</div>
  </div>
  <div class="stage">{{ photo(0,'a') }}{{ photo(1,'b') }}</div>
  {% if c.subtitle %}<div class="s">{{ c.subtitle }}</div>{% endif %}
</div>
