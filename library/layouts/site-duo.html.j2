<style>
.L-site-duo *{hyphens:manual!important;-webkit-hyphens:manual!important;overflow-wrap:normal!important;word-break:normal!important}
.L-site-duo .pad{justify-content:center;gap:5cqw}
.canvas.fmt-reel.L-site-duo .pad,.canvas.fmt-story.L-site-duo .pad{padding-top:24cqw;padding-bottom:28cqw}
.L-site-duo .chip{align-self:flex-start;display:inline-flex;align-items:center;gap:2cqw;font-family:var(--font-body),Inter;font-size:3cqw;letter-spacing:.16em;text-transform:uppercase;font-weight:600;color:var(--muted)}
.L-site-duo .chip i{width:2.3cqw;height:2.3cqw;border-radius:50%;background:var(--accent);display:block;box-shadow:0 0 0 1.1cqw color-mix(in srgb,var(--accent) 24%,transparent)}
.L-site-duo .stage{position:relative;flex:1 1 0;min-height:0;perspective:130cqw;perspective-origin:50% 40%;display:flex;gap:4cqw;align-items:center}
.L-site-duo .card{position:relative;flex:1 1 0;height:92%;border-radius:var(--card-radius);overflow:hidden;background:var(--surface);box-shadow:0 3cqw 7cqw rgba(0,0,0,.24),0 0 0 .25cqw var(--line)}
.L-site-duo .card .photo{position:absolute!important;inset:0;border-radius:0;border:0;box-shadow:none}
.L-site-duo .card img,.L-site-duo .card video{width:100%;height:100%;object-fit:cover}
.L-site-duo .a{rotate:0 1 0 9deg;translate:0 -3cqw 0}
.L-site-duo .b{rotate:0 1 0 -9deg;translate:0 4cqw 2cqw}
.L-site-duo .t{font-size:8.4cqw;line-height:1;flex:0 1 auto;max-height:22cqh;min-height:0}
.L-site-duo .s{font-size:3.8cqw;line-height:1.36;color:var(--muted)}
</style>
<div class="pad col">
  {% if c.kicker %}<div class="chip"><i></i>{{ c.kicker }}</div>{% endif %}
  <div class="stage"><div class="card a item">{{ photo(0,'flat') }}</div><div class="card b item">{{ photo(1,'flat') }}</div></div>
  <div class="t fit">{{ rich(c.title) }}</div>
  {% if c.subtitle %}<div class="s">{{ c.subtitle }}</div>{% endif %}
</div>
