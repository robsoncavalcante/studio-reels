<style>
.L-site-video *{hyphens:manual!important;-webkit-hyphens:manual!important;overflow-wrap:normal!important;word-break:normal!important}
.L-site-video .pad{justify-content:flex-end;gap:4cqw;padding-bottom:30cqw}
.L-site-video .vid{position:absolute;inset:-3%;overflow:hidden}
.L-site-video .vid .photo{position:absolute!important;inset:0;border-radius:0;border:0;box-shadow:none}
.L-site-video .vid video,.L-site-video .vid img{width:100%;height:100%;object-fit:cover}
.L-site-video .shade{position:absolute;inset:0;background:linear-gradient(0deg,rgba(0,0,0,.82) 0%,rgba(0,0,0,.5) 38%,rgba(0,0,0,.05) 70%)}
.L-site-video .chip{align-self:flex-start;display:inline-flex;align-items:center;gap:2cqw;font-family:var(--font-body),Inter;font-size:3cqw;letter-spacing:.16em;text-transform:uppercase;font-weight:700;color:#fff;background:var(--accent);padding:1.6cqw 3.4cqw;border-radius:99cqw}
.L-site-video .t{font-size:10.6cqw;line-height:.96;color:#fff;max-height:34cqh;flex:0 1 auto;min-height:0;text-shadow:0 .4cqw 2.4cqw rgba(0,0,0,.45)}
.L-site-video .s{font-size:4.2cqw;line-height:1.38;color:rgba(255,255,255,.92);max-width:92%}
</style>
<div class="vid">{{ photo(0,'flat bgph') }}</div><div class="shade"></div>
<div class="pad col">
  {% if c.kicker %}<span class="chip">{{ c.kicker }}</span>{% endif %}
  <div class="t fit">{{ rich(c.title) }}</div>
  {% if c.subtitle %}<div class="s">{{ c.subtitle }}</div>{% endif %}
</div>
