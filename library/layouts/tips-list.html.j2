<style>
.L-tips-list .t{font-size:10.4cqw;max-height:20cqh;flex:0 1 auto;min-height:0}
.L-tips-list .list{flex:1 1 0;min-height:0;display:flex;flex-direction:column;justify-content:space-between;gap:2cqw;font-size:3.5cqw}
.L-tips-list .it{display:flex;gap:3.4cqw;align-items:flex-start;flex:1 1 0;min-height:0;padding:2.4cqw 0;border-top:.3cqw solid var(--line)}
.L-tips-list .it:first-child{border-top:0}
.L-tips-list .num-circle{width:2.8em;height:2.8em;font-size:1em}
.L-tips-list .it h4{font-size:1.18em;font-weight:800;line-height:1.15;margin-bottom:.3em}
.L-tips-list .it p{font-size:.92em;color:var(--muted);line-height:1.38}
</style>
<div class="pad col gap3">
  <div class="col gap1">
    {% if c.kicker %}<div class="k">{{ c.kicker }}</div>{% endif %}
    <div class="t fit">{{ rich(c.title) }}</div>
  </div>
  <div class="list fit">
    {% for it in c['items'][:5] %}<div class="it item"><div class="num-circle">{{ loop.index }}</div><div><h4>{{ it.title }}</h4>{% if it.text %}<p>{{ it.text }}</p>{% endif %}</div></div>{% endfor %}
  </div>
</div>
