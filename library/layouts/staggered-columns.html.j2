<style>
.L-staggered-columns .t{font-size:10cqw;max-height:20cqh;flex:0 1 auto;min-height:0}
.L-staggered-columns .cols{flex:1 1 0;min-height:0;display:flex;gap:2.4cqw;overflow:hidden}
.L-staggered-columns .cols>div{flex:1;display:flex;flex-direction:column;gap:2.4cqw;min-height:0}
.L-staggered-columns .cols>div:nth-child(2){margin-top:9cqw}
.L-staggered-columns .cols .photo{position:relative}
</style>
<div class="pad col gap3">
  <div class="col gap1">
    {% if c.kicker %}<div class="k">{{ c.kicker }}</div>{% endif %}
    <div class="t fit">{{ rich(c.title) }}</div>
  </div>
  <div class="cols">
    <div>{{ photo(0,'','flex:1.2') }}{{ photo(1,'','flex:.8') }}{{ photo(2,'','flex:1') }}</div>
    <div>{{ photo(3,'','flex:.8') }}{{ photo(4,'','flex:1.2') }}{{ photo(5,'','flex:.9') }}</div>
  </div>
  {% if c.subtitle %}<div class="s">{{ c.subtitle }}</div>{% endif %}
</div>
