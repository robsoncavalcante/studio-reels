<style>
.L-cta-follow .pad{justify-content:center;align-items:center;text-align:center;gap:3.4cqw}
.L-cta-follow .av{width:30cqw;height:30cqw;border-radius:50%!important;border:1cqw solid var(--accent)!important;flex:none}
.L-cta-follow .t{font-size:11.6cqw;max-height:30cqh;flex:0 1 auto;min-height:0;width:100%}
.L-cta-follow .handle{font-size:4.6cqw;font-weight:800;color:var(--accent-text,var(--accent));letter-spacing:.02em}
.L-cta-follow .acts{display:flex;gap:8cqw;margin:1cqw 0}
.L-cta-follow .acts div{display:flex;flex-direction:column;align-items:center;gap:1.4cqw;font-size:2.5cqw;font-weight:700;letter-spacing:.1em;text-transform:uppercase}
.L-cta-follow .acts svg{width:9.5cqw;height:9.5cqw;stroke:var(--fg);fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
</style>
<div class="pad col">
  {{ photo(0,'av') }}
  <div class="handle">{{ c.handle or (brand.handle if brand else None) or '@suamarca' }}</div>
  <div class="t fit">{{ rich(c.title) }}</div>
  {% if c.subtitle %}<div class="s" style="max-width:84%">{{ c.subtitle }}</div>{% endif %}
  <div class="acts">
    <div><svg viewBox="0 0 24 24"><path d="M20.8 5.6a5.2 5.2 0 0 0-7.4 0L12 7l-1.4-1.4a5.2 5.2 0 0 0-7.4 7.4L12 21.8l8.8-8.8a5.2 5.2 0 0 0 0-7.4z"/></svg>Curta</div>
    <div><svg viewBox="0 0 24 24"><path d="M21 12a8 8 0 0 1-11.6 7.1L3 21l1.9-6.4A8 8 0 1 1 21 12z"/></svg>Comente</div>
    <div><svg viewBox="0 0 24 24"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4z"/></svg>Envie</div>
    <div><svg viewBox="0 0 24 24"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>Salve</div>
  </div>
  <span class="cta">{{ c.cta or 'Seguir' }} <i class="arrow"></i></span>
</div>
