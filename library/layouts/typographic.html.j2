<style>
.L-typographic .pad{gap:3cqw}
.L-typographic .t{font-size:19cqw;line-height:.94;flex:1 1 0;min-height:0;display:flex;align-items:center}
.L-typographic .t.fit{display:block}
.L-typographic .foot{display:flex;align-items:center;justify-content:space-between;gap:3cqw;border-top:.4cqw solid var(--fg);padding-top:2.6cqw}
</style>
<div class="pad col">
  {% if c.kicker %}<div class="k">{{ c.kicker }}</div>{% endif %}
  <div class="t fit">{{ rich(c.title) }}</div>
  {% if c.subtitle or c.cta %}<div class="foot"><div class="s" style="max-width:76%">{{ c.subtitle or '' }}</div>{% if c.cta %}<span class="cta">{{ c.cta }}</span>{% else %}<i class="arrow" style="font-size:7cqw;color:var(--accent-text,var(--accent))"></i>{% endif %}</div>{% endif %}
</div>
