<style>
.L-profile-card .pad{gap:3.4cqw}
.L-profile-card .top{display:flex;gap:5cqw;align-items:center}
.L-profile-card .top .photo{width:34cqw;height:34cqw;flex:none;border-radius:50%!important;border:1cqw solid var(--accent)!important}
.L-profile-card .t{font-size:9.6cqw;max-height:20cqh;flex:0 1 auto;min-height:0}
.L-profile-card .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:2.4cqw}
.L-profile-card .stats div{text-align:center;padding:3.4cqw 1cqw}
.L-profile-card .stats b{display:block;font-family:var(--font-display),Inter;font-weight:var(--dw);font-size:7.6cqw;color:var(--accent-text,var(--accent));line-height:1}
.L-profile-card .stats span{font-size:2.4cqw;letter-spacing:.12em;text-transform:uppercase;font-weight:700;color:var(--muted)}
.L-profile-card .list{flex:1 1 0;min-height:0;display:flex;flex-direction:column;justify-content:center;gap:2.6cqw;font-size:3.6cqw}
.L-profile-card .li{display:flex;gap:2.8cqw;align-items:center;font-weight:600}
.L-profile-card .li::before{content:"";width:2.6cqw;height:2.6cqw;border-radius:50%;background:var(--accent);flex:none}
</style>
<div class="pad col">
  <div class="top">{{ photo(0) }}<div class="col gap1">{% if c.kicker %}<div class="k">{{ c.kicker }}</div>{% endif %}<div class="t fit">{{ rich(c.title) }}</div>{% if c.subtitle %}<div class="s">{{ c.subtitle }}</div>{% endif %}</div></div>
  <div class="stats">{% for s in (c.stats or [])[:3] %}<div class="surface item"><b>{{ s.value }}</b><span>{{ s.label }}</span></div>{% endfor %}</div>
  <div class="list fit">{% for it in c['items'][:5] %}<div class="li item">{{ it.title }}</div>{% endfor %}</div>
  {% if c.cta %}<div><span class="cta">{{ c.cta }} <i class="arrow"></i></span></div>{% endif %}
</div>
