<style>
.L-site-cover *{hyphens:manual!important;-webkit-hyphens:manual!important;overflow-wrap:normal!important;word-break:normal!important}
.L-site-cover .pad{justify-content:flex-end;gap:4.2cqw;padding-bottom:30cqw}
.L-site-cover .vid{position:absolute;inset:-3%;overflow:hidden}
.L-site-cover .vid .photo{position:absolute!important;inset:0;border-radius:0;border:0;box-shadow:none}
.L-site-cover .vid video,.L-site-cover .vid img{width:100%;height:100%;object-fit:cover}
.L-site-cover .shade{position:absolute;inset:0;background:linear-gradient(0deg,rgba(0,0,0,.86) 0%,rgba(0,0,0,.6) 44%,rgba(0,0,0,.12) 78%)}
.L-site-cover .t{font-size:10.4cqw;line-height:.96;color:#fff;max-height:34cqh;flex:0 1 auto;min-height:0;text-shadow:0 .4cqw 2.4cqw rgba(0,0,0,.45)}
.L-site-cover .s{font-size:4.1cqw;line-height:1.38;color:rgba(255,255,255,.92);max-width:92%}
.L-site-cover .ck{display:flex;flex-direction:column;gap:2.6cqw}
.L-site-cover .ck div{display:flex;align-items:center;gap:3cqw;color:#fff;font-family:var(--font-body),Inter;font-size:4cqw;font-weight:600}
.L-site-cover .ck i{flex:none;width:6.4cqw;height:6.4cqw;border-radius:50%;background:var(--accent);display:grid;place-items:center}
.L-site-cover .ck i svg{width:3.8cqw;height:3.8cqw;stroke:var(--on-accent);fill:none;stroke-width:3.4;stroke-linecap:round;stroke-linejoin:round}
.L-site-cover .bt{align-self:flex-start;display:inline-flex;align-items:center;gap:2.2cqw;height:12cqw;padding:0 5.4cqw;border-radius:var(--btn-radius);background:var(--accent);color:var(--on-accent);font-family:var(--font-body),Inter;font-size:4cqw;font-weight:700}
</style>
<div class="vid">{{ photo(0,'flat bgph') }}</div><div class="shade"></div>
<div class="pad col">
  <div class="t fit">{{ rich(c.title) }}</div>
  {% if c.subtitle %}<div class="s">{{ c.subtitle }}</div>{% endif %}
  {% if c.items %}<div class="ck">{% for it in c.items[:4] %}<div class="item"><i><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></i>{{ it.title }}</div>{% endfor %}</div>{% endif %}
  {% if c.cta %}<span class="bt">{{ c.cta }}</span>{% endif %}
</div>
