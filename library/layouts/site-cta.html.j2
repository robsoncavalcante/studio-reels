<style>
.L-site-cta *{hyphens:manual!important;-webkit-hyphens:manual!important;overflow-wrap:normal!important;word-break:normal!important}
.L-site-cta .pad{justify-content:center;gap:5cqw}
.canvas.fmt-reel.L-site-cta .pad,.canvas.fmt-story.L-site-cta .pad{padding-top:26cqw;padding-bottom:30cqw}
.L-site-cta .chip{align-self:flex-start;display:inline-flex;align-items:center;gap:2cqw;font-family:var(--font-body),Inter;font-size:3cqw;letter-spacing:.16em;text-transform:uppercase;font-weight:600;color:var(--muted)}
.L-site-cta .chip i{width:2.3cqw;height:2.3cqw;border-radius:50%;background:var(--accent);box-shadow:0 0 0 1.1cqw color-mix(in srgb,var(--accent) 24%,transparent);display:block}
.L-site-cta .t{font-size:11.6cqw;line-height:.94;max-height:44cqh;flex:0 1 auto;min-height:0}
.L-site-cta .s{font-size:4.2cqw;max-width:94%;line-height:1.4}
.L-site-cta .bt{align-self:flex-start;display:inline-flex;align-items:center;gap:2.2cqw;height:12cqw;padding:0 5cqw;border-radius:var(--btn-radius);background:var(--accent);color:var(--on-accent);font-family:var(--font-body),Inter;font-size:4cqw;font-weight:600}
.L-site-cta .bt svg{width:5cqw;height:5cqw}
.L-site-cta .who{margin-top:2cqw;border-top:.3cqw dashed var(--line);padding-top:4cqw;display:flex;align-items:center;gap:3.4cqw;font-size:3.4cqw;color:var(--muted)}
.L-site-cta .who .photo{width:13cqw;height:13cqw;border-radius:50%!important;flex:none;background:var(--surface)}
.L-site-cta .who b{display:block;color:var(--fg);font-size:3.8cqw}
</style>
<div class="pad col">
  {% if c.kicker %}<div class="chip"><i></i>{{ c.kicker }}</div>{% endif %}
  <div class="t fit">{{ rich(c.title) }}</div>
  {% if c.subtitle %}<div class="s">{{ c.subtitle }}</div>{% endif %}
  {% if c.cta %}<span class="bt">{{ c.cta }}{{ icon('arrow-right') }}</span>{% endif %}
</div>
