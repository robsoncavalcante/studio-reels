<style>
.L-circle-orbit .pad{align-items:center;text-align:center;justify-content:center;gap:3.6cqw}
.L-circle-orbit .orbit{position:relative;width:86cqw;height:86cqw;flex:none}
.L-circle-orbit .orbit .circ{position:absolute;inset:12.5%;border-radius:50%!important}
.L-circle-orbit .orbit svg{position:absolute;inset:0;width:100%;height:100%}
.L-circle-orbit .t{font-size:9.6cqw;max-height:22cqh;flex:0 1 auto;min-height:0;width:100%}
</style>
{% set ring = ((c.badge or c.kicker or 'novidade') | upper) %}
{% set unit = ring ~ '  •  ' %}
<div class="pad col">
  <div class="orbit">
    <svg viewBox="0 0 400 400" class="ring"><defs><path id="cp" d="M200 200 m-172 0 a172 172 0 1 1 344 0 a172 172 0 1 1 -344 0"/></defs>
    <text fill="var(--accent)" font-size="23" font-weight="800" letter-spacing="3" style="font-family:var(--font-body),Inter"><textPath href="#cp" textLength="1070" lengthAdjust="spacing">{{ unit * ((44 // (unit|length)) + 1) }}</textPath></text></svg>
    {{ photo(0,'circ') }}
  </div>
  <div class="t fit">{{ rich(c.title) }}</div>
  {% if c.subtitle %}<div class="s">{{ c.subtitle }}</div>{% endif %}
</div>
