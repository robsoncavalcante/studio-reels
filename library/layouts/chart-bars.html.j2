<style>
.L-chart-bars .pad{gap:4cqw;justify-content:center}
.L-chart-bars .t{font-size:9cqw;line-height:1.02}
.L-chart-bars .sub{font-size:3.6cqw;color:var(--muted)}
.L-chart-bars .plot{display:flex;align-items:flex-end;gap:3.2cqw;height:46cqh;margin-top:2cqw;border-bottom:.35cqw solid var(--line);padding:0 1cqw}
.L-chart-bars .col{flex:1;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;height:100%;min-width:0}
.L-chart-bars .val{font-family:var(--font-display);font-weight:700;font-size:4.6cqw;margin-bottom:1.6cqw;white-space:nowrap}
.L-chart-bars .bar{width:100%;border-radius:1.6cqw 1.6cqw 0 0;background:var(--accent);transform-origin:bottom}
.L-chart-bars .col.hi .bar{background:linear-gradient(var(--accent2,var(--accent)),var(--accent))}
.L-chart-bars .col:not(.hi) .bar{opacity:.62}
.L-chart-bars .lab{font-size:3.2cqw;color:var(--muted);text-align:center;margin-top:2cqw;line-height:1.15}
@keyframes kf-bar{0%{transform:scaleY(0)}70%{transform:scaleY(1.05)}100%{transform:scaleY(1)}}
@keyframes kf-val{from{opacity:0;transform:translateY(2cqw)}to{opacity:1;transform:none}}
.reel.L-chart-bars .bar,.canvas.reel .L-chart-bars .bar{animation:kf-bar .9s cubic-bezier(.2,.8,.2,1) calc(.5s + var(--bi) * .16s) both}
.reel .L-chart-bars .val{animation:kf-val .5s ease calc(.9s + var(--bi) * .16s) both}
</style>
{% set vals = c['items'] | map(attribute='value') | map('float') | list %}
{% set mx = (vals | max) if vals else 1 %}
<div class="pad col">
  {% if c.kicker %}<div class="k">{{ c.kicker }}</div>{% endif %}
  <div class="t fit">{{ rich(c.title) }}</div>
  {% if c.subtitle %}<div class="sub">{{ c.subtitle }}</div>{% endif %}
  <div class="plot" data-a>
  {% for it in c['items'] %}
    <div class="col {{ 'hi' if (it.value | float) == mx else '' }}" style="--bi:{{ loop.index0 }}">
      <div class="val">{{ it.text or it.value }}</div>
      <div class="bar" style="height:{{ ((it.value | float) / mx * 100) | round(1) }}%"></div>
    </div>
  {% endfor %}
  </div>
  <div class="plot" data-a style="height:auto;border:0;margin-top:-3cqw">
  {% for it in c['items'] %}<div class="col" style="height:auto"><div class="lab">{{ it.title }}</div></div>{% endfor %}
  </div>
</div>
