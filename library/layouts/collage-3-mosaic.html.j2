<style>
.L-collage-3-mosaic .t{font-size:10cqw;max-height:20cqh;flex:0 1 auto;min-height:0}
.L-collage-3-mosaic .mos{flex:1 1 0;min-height:0;display:grid;grid-template-columns:1.25fr 1fr;grid-template-rows:1fr 1fr;gap:2.4cqw}
.L-collage-3-mosaic .mos .photo{position:relative}
.L-collage-3-mosaic .mos .p0{grid-row:1/3}
</style>
<div class="pad col gap3">
  <div class="col gap1">
    {% if c.kicker %}<div class="k">{{ c.kicker }}</div>{% endif %}
    <div class="t fit">{{ rich(c.title) }}</div>
  </div>
  <div class="mos">{{ photo(0,'p0') }}{{ photo(1,'p1') }}{{ photo(2,'p2') }}</div>
  {% if c.subtitle %}<div class="s">{{ c.subtitle }}</div>{% endif %}
</div>
