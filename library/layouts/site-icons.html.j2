<style>
.L-site-icons *{hyphens:manual!important;-webkit-hyphens:manual!important;overflow-wrap:normal!important;word-break:normal!important}
.L-site-icons .pad{justify-content:center;gap:4.4cqw}
.canvas.fmt-reel.L-site-icons .pad,.canvas.fmt-story.L-site-icons .pad{padding-top:25cqw;padding-bottom:27cqw}
.L-site-icons .chip{align-self:flex-start;display:inline-flex;align-items:center;gap:2cqw;font-family:var(--font-body),Inter;font-size:3cqw;letter-spacing:.16em;text-transform:uppercase;font-weight:600;color:var(--muted)}
.L-site-icons .chip i{width:2.3cqw;height:2.3cqw;border-radius:50%;background:var(--accent);display:block;box-shadow:0 0 0 1.1cqw color-mix(in srgb,var(--accent) 24%,transparent)}
.L-site-icons .t{font-size:10.8cqw;line-height:.96;max-height:26cqh;flex:0 1 auto;min-height:0}
.L-site-icons .rows{display:flex;flex-direction:column;gap:3cqw;flex:1 1 0;min-height:0}
.L-site-icons .ic{flex:1 1 0;min-height:0;display:flex;align-items:center;gap:5cqw;padding:2cqw 4cqw;overflow:hidden;border-radius:var(--card-radius);background:var(--surface);box-shadow:0 0 0 .25cqw var(--line)}
.L-site-icons .bub{position:relative;flex:none;width:15cqw;height:15cqw;border-radius:50%;background:#fff;box-shadow:0 0 0 .6cqw var(--accent);display:grid;place-items:center}
.L-site-icons .bub::before,.L-site-icons .bub::after{content:"";position:absolute;inset:0;border-radius:50%;border:.5cqw solid var(--accent);opacity:0;animation:icon-ping 1.8s var(--ez-out-quart,ease-out) infinite}
.L-site-icons .bub::after{animation-delay:.9s}
.L-site-icons .bub img,.L-site-icons .bub svg{width:62%;height:62%;object-fit:contain;}
.L-site-icons .bub .dot{font-family:var(--font-display),Inter;font-weight:800;font-size:7cqw;color:var(--accent)}
.L-site-icons .tt{font-family:var(--font-display),Inter;font-weight:700;font-size:4.5cqw;line-height:1.08;letter-spacing:-.02em}
.L-site-icons .sp{font-size:2.8cqw;line-height:1.28;color:var(--muted);margin-top:.6cqw;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
</style>
<div class="pad col">
  {% if c.kicker %}<div class="chip"><i></i>{{ c.kicker }}</div>{% endif %}
  <div class="t fit">{{ rich(c.title) }}</div>
  <div class="rows" data-focus="1">{% for it in c['items'][:4] %}<div class="ic item"><div class="bub">{% if it.icon %}<img src="{{ it.icon }}" alt="" style="{% if (it.icon_kind or 'glyph') == 'photo' %}width:100%;height:100%;object-fit:cover;border-radius:50%{% endif %}">{% else %}<span class="dot">{{ loop.index }}</span>{% endif %}</div><div><div class="tt">{{ it.title }}</div>{% if it.text %}<div class="sp">{{ it.text }}</div>{% endif %}</div></div>{% endfor %}</div>
</div>
